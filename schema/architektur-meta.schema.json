{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xXUltraGoldXx/stil-bibliothek/schema/architektur-meta.schema.json",
  "title": "Architektur-Metadaten (architekturen/<slug>/meta.json)",
  "description": "Beschreibt eine Projekt-Architektur. Maximal 4 KB. Der Pruefer werkzeuge/pruefer.py setzt zusaetzliche Regeln durch.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "beschreibung", "sprache", "stack", "kategorien", "schlagworte", "quelle", "reifegrad"],
  "properties": {
    "name": { "type": "string", "minLength": 2, "maxLength": 60, "pattern": "^[^\\r\\n]+$" },
    "slug": { "type": "string", "maxLength": 60, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Muss dem Ordnernamen entsprechen." },
    "beschreibung": { "type": "string", "minLength": 10, "maxLength": 320, "pattern": "^[^\\r\\n]+$" },
    "sprache": { "type": "string", "description": "Hauptsprache, Eintrag aus architekturen/kategorien.json (sprachen)." },
    "stack": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 60 } },
    "kategorien": {
      "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true,
      "description": "Nur Eintraege aus architekturen/kategorien.json.",
      "items": { "type": "string", "pattern": "^[A-Za-z0-9ÄÖÜäöüß][A-Za-z0-9ÄÖÜäöüß /-]{0,23}$" }
    },
    "schlagworte": { "type": "array", "minItems": 2, "maxItems": 14, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 24 } },
    "quelle": { "enum": ["erprobt", "recherchiert"], "description": "erprobt = aus einem laufenden Projekt abgelesen, recherchiert = aus oeffentlicher Best Practice." },
    "reifegrad": { "enum": ["erprobt", "recherchiert, ungetestet", "abgeleitet"] }
  }
}
