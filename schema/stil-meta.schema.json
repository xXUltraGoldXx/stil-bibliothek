{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xXUltraGoldXx/stil-bibliothek/schema/stil-meta.schema.json",
  "title": "Stil-Metadaten (stile/<slug>/meta.json)",
  "description": "Beschreibt einen Design-Stil. Maximal 4 KB. Der Pruefer werkzeuge/pruefer.py setzt zusaetzliche Regeln durch (keine Anweisungen, keine Marken, keine Herkunftsangaben), die ein Schema nicht abbildet.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "beschreibung", "schlagworte", "kategorien"],
  "properties": {
    "name": { "type": "string", "minLength": 2, "maxLength": 60, "pattern": "^[^\\r\\n]+$" },
    "slug": { "type": "string", "maxLength": 60, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Muss dem Ordnernamen entsprechen." },
    "beschreibung": { "type": "string", "minLength": 10, "maxLength": 320, "pattern": "^[^\\r\\n]+$" },
    "schlagworte": {
      "type": "array", "minItems": 2, "maxItems": 10, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 24 }
    },
    "kategorien": {
      "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true,
      "description": "Nur Eintraege aus kategorien.json.",
      "items": { "type": "string", "pattern": "^[A-Za-z0-9ÄÖÜäöüß][A-Za-z0-9ÄÖÜäöüß /-]{0,23}$" }
    },
    "gegenbeispiel": { "type": "boolean", "description": "true = Beispiel dafuer, wie es nicht aussehen soll." }
  }
}
